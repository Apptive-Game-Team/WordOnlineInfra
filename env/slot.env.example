# Per-slot environment. One file per slot:
#
#   game/ac-game-blue.env    game/ac-game-green.env
#   game/dev-game-blue.env   game/dev-game-green.env
#
# Layered on top of ac-game.env / dev-game.env, so it only holds what differs
# between blue and green. Everything shared — database, account server, JWT
# key — stays in the environment file.
#
# This is the address the server writes into the Server table, which is what
# clients dial. Behind a proxy it is the proxy's address, not the port the
# container publishes on the host. Without a proxy, set EXTERNAL_PORT to the
# slot's published port (SLOT_*_PORT in docker-compose.yml) or leave it out
# entirely and the deployer fills in the published port.

PROTOCOL=wss
DOMAIN=
EXTERNAL_PORT=
