# Development game server environment.
# Copy to game/dev-game.env on the host and fill in. Never commit the filled copy.
#
# Must point at the dev database and the dev account server. Sharing either with
# ac-game would let a broken main branch write to production data.
#
# PORT, MANAGEMENT_PORT and EXTERNAL_PORT are NOT set here — the deployer
# injects them per slot so blue and green publish different host ports.

PROTOCOL=wss
DOMAIN=

DATABASE_URL=jdbc:postgresql://<host>:5432/<dev-database>
DATABASE_USER=
DATABASE_PW=

ACCOUNT_SERVER_URL=
JWT_PUBLIC_KEY=

DISCORD_WEBHOOK_URL=

# Optional, defaults live in the server's application.yml.
# HEARTBEAT_INTERVAL_MS=10000
# MAX_SESSIONS=20
