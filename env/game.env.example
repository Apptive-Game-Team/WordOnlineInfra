# Shared environment for every game server slot.
# Copy to game/game.env on the server and fill in. Never commit the filled copy.
#
# PORT, MANAGEMENT_PORT and EXTERNAL_PORT are NOT set here — the deployer
# injects them per slot so blue and green publish different host ports.

PROTOCOL=wss
DOMAIN=

DATABASE_URL=jdbc:postgresql://<host>:5432/<database>
DATABASE_USER=
DATABASE_PW=

ACCOUNT_SERVER_URL=
JWT_PUBLIC_KEY=

DISCORD_WEBHOOK_URL=

# Optional, defaults live in the server's application.yml.
# HEARTBEAT_INTERVAL_MS=10000
# MAX_SESSIONS=100
