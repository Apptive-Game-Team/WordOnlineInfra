# Compose-level variables for the deployers.
# Copy to game/.env on the host and fill in. Never commit the filled copy.

# Image tags. Overriding these pins a deploy to a specific build.
AC_GAME_IMAGE=ghcr.io/apptive-game-team/arcane-casters-game:latest
DEV_GAME_IMAGE=ghcr.io/apptive-game-team/arcane-casters-game:dev
DEPLOYER_IMAGE=ghcr.io/apptive-game-team/arcane-casters-deployer:latest

# JWTs carrying the WORDONLINE_CICD authority. One per environment — the dev
# token is issued by the dev account server and is not valid in production.
AC_CICD_TOKEN=
DEV_CICD_TOKEN=

# Optional. Deploy notifications, usually two different channels.
AC_DISCORD_WEBHOOK_URL=
DEV_DISCORD_WEBHOOK_URL=

# Optional. Seconds both slots stay up after the new one reports UP, before the
# old one is drained. Defaults to 30. Raise it when the lobby needs longer to put
# the new slot into rotation; see the swap sequence in README.md.
AC_SETTLE_DELAY=
DEV_SETTLE_DELAY=
